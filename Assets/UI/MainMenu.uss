/* ========================================
   Project Aegis - Main Menu Stylesheet
   ======================================== */

/* Root */
.menu-root {
    flex-grow: 1;
    flex-direction: column;
    align-items: stretch;
    background-color: rgb(8, 10, 18);
}

/* Animated top accent bar */
.top-bar {
    height: 4px;
    background-color: rgb(0, 212, 255);
}

/* Centred content */
.menu-center {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.title-sub {
    font-size: 14px;
    color: rgb(0, 212, 255);
    -unity-font-style: bold;
    letter-spacing: 6px;
    margin-bottom: 8px;
}

.title-main {
    font-size: 62px;
    -unity-font-style: bold;
    color: rgb(230, 235, 245);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.title-accent {
    color: rgb(0, 212, 255);
}

.title-desc {
    font-size: 14px;
    color: rgb(120, 140, 180);
    margin-top: 12px;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}

.divider {
    width: 320px;
    height: 1px;
    background-color: rgba(0, 212, 255, 0.25);
    margin-top: 40px;
    margin-bottom: 40px;
}

.btn-play {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(8, 10, 18);
    background-color: rgb(0, 212, 255);
    border-width: 0;
    border-radius: 6px;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 60px;
    padding-right: 60px;
    letter-spacing: 2px;
    transition-duration: 0.15s;
    transition-property: background-color, scale;
}

.btn-play:hover {
    background-color: rgb(80, 230, 255);
    scale: 1.04;
}

.btn-play:active {
    background-color: rgb(0, 170, 200);
    scale: 0.97;
}

.watermark {
    font-size: 11px;
    color: rgba(120, 140, 180, 0.5);
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}

/* ========================================
   Loading Overlay
   ======================================== */

.loading-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 10, 18, 0.96);
    align-items: center;
    justify-content: center;
}

.loading-box {
    align-items: center;
    width: 480px;
}

.loading-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(0, 212, 255);
    letter-spacing: 4px;
    margin-bottom: 32px;
    -unity-text-align: middle-center;
}

.progress-track {
    width: 100%;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 20px;
}

.progress-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(0, 212, 255);
    border-radius: 2px;
    transition-duration: 0.3s;
    transition-property: width;
}

.loading-hint {
    font-size: 13px;
    color: rgba(180, 200, 230, 0.7);
    -unity-text-align: middle-center;
    margin-bottom: 36px;
}

/* Spinner dots row */
.spinner-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: rgb(0, 212, 255);
    margin-left: 6px;
    margin-right: 6px;
    opacity: 0.25;
}
