<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="MainMenu.uss" />

    <!-- Background with animated particles feel -->
    <ui:VisualElement name="MenuRoot" class="menu-root">

        <!-- Decorative top bar -->
        <ui:VisualElement class="top-bar" />

        <!-- Main content -->
        <ui:VisualElement class="menu-center">
            <ui:Label text="PROJECT AEGIS" class="title-sub" />
            <ui:Label text="Adaptive Outbreak" class="title-main" />
            <ui:Label text="Containment Engine" class="title-main title-accent" />
            <ui:Label text="SEIQR Agent-Based Epidemic Simulation" class="title-desc" />

            <ui:VisualElement class="divider" />

            <ui:Button name="btnPlay" text="▶  LAUNCH SIMULATION" class="btn-play" />
        </ui:VisualElement>

        <!-- Version watermark -->
        <ui:Label text="v1.0  |  Fermisloth" class="watermark" />
    </ui:VisualElement>

    <!-- Loading / Transition Overlay (hidden by default) -->
    <ui:VisualElement name="LoadingOverlay" class="loading-overlay" style="display: none;">
        <ui:VisualElement class="loading-box">
            <ui:Label text="INITIALISING SIMULATION" class="loading-title" />
            <ui:VisualElement class="progress-track">
                <ui:VisualElement name="progressBar" class="progress-fill" />
            </ui:VisualElement>
            <ui:Label name="loadingHint" text="Loading city layout…" class="loading-hint" />
            <!-- Spinner dots -->
            <ui:VisualElement class="spinner-row">
                <ui:VisualElement name="dot0" class="dot" />
                <ui:VisualElement name="dot1" class="dot" />
                <ui:VisualElement name="dot2" class="dot" />
                <ui:VisualElement name="dot3" class="dot" />
                <ui:VisualElement name="dot4" class="dot" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
